<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.local.environment</string>
    <key>ProgramArguments</key>
    <array>
      <!-- set env variables for the entire login session, so that VS Code
           and other IDEs see them. Goes through sh to expand $HOME. -->
      <string>/bin/sh</string>
      <string>-c</string>
      <string>
        launchctl setenv RUSTUP_HOME "$HOME/.local/share/rustup"
        launchctl setenv COPILOT_HOME "$HOME/.config/copilot"
      </string>
    </array>
    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>
