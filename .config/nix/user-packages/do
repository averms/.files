#!/usr/bin/env bash
#
# do -- budget GNU Make

set -eu
shopt -s inherit_errexit

add-default() {
    nix profile add .#default
}

upgrade-all() {
    nix profile upgrade --all
}

pin() {
    local metadata
    local registry=$HOME/.config/nix/registry.json
    nix registry pin nixpkgs "https://channels.nixos.org/nixpkgs-unstable/nixexprs.tar.zst"
    jq '.flakes |= map(if .from == {id: "nixpkgs", type: "indirect"} then .exact = true else . end)' \
        "$registry" >"$registry.new"
    mv "$registry.new" "$registry"
    metadata=$(nix flake metadata nixpkgs --json)

    nix flake update nixpkgs --override-flake nixpkgs "$(jq -r .url <<<"$metadata")"

    local root=$HOME/.local/state/nix/gcroots/nixpkgs
    mkdir -p "$(dirname "$root")"
    nix build --out-link "$root" "$(jq -r .path <<<"$metadata")"
}

graphics() {
    local graphics
    graphics=$(nix build .#graphics --no-link --print-out-paths)
    sudo nix build --no-link --profile /nix/var/nix/profiles/graphics "$graphics"
}

help() {
    echo "$0 <task> [args]"
    echo
    compgen -A function | grep -v '^_' | cat -n
}

cd "$(dirname "${BASH_SOURCE[0]}")"
TIMEFORMAT="Task completed in %3lR"
time "${@:-help}"
