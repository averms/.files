{
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[makefile]": {
    "editor.insertSpaces": false
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": ["--header-insertion=never"],
  "cmake.configureOnOpen": true,
  "crashReporting.enabled": "off",
  "cursorpyright.analysis.autoImportCompletions": false,
  "cursorpyright.analysis.inlayHints.genericTypes": false,
  "cursorpyright.shouldImportPylanceSettings": "never",
  "dev.containers.dockerPath": "podman",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.codeLens": false,
  "editor.fontFamily": "Input Sans Narrow",
  "editor.fontSize": 13,
  "editor.guides.highlightActiveIndentation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlayHints.enabled": "on",
  "editor.lineHeight": 1.2,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.renderFinalNewline": "off",
  "editor.scrollBeyondLastLine": false,
  "editor.selectionHighlight": false,
  "editor.semanticHighlighting.enabled": false,
  "editor.snippetSuggestions": "bottom",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.wordWrapColumn": 88,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
    "vscodevim.vim": 2
  },
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    ".clang-format": "yaml",
    ".clang-tidy": "yaml",
    "*.h": "c",
    "*.log": "plaintext"
  },
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.jj": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "git.confirmSync": false,
  "git.countBadge": "off",
  "git.decorations.enabled": false,
  "git.openRepositoryInParentFolders": "always",
  "github.copilot.enable": {
    "*": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "js/ts.suggest.autoImports": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "json.schemaDownload.enable": true,
  "jupyter.askForKernelRestart": false,
  "markdown.preview.fontFamily": "sans-serif",
  "markdown.preview.markEditorSelection": false,
  "mesonbuild.buildFolder": "build-vscode",
  "mesonbuild.configureOnOpen": true,
  "mesonbuild.configureOptions": ["-Dbuildtype=debug", "-Dcpp_args=-g3"],
  "mesonbuild.downloadLanguageServer": true,
  "notebook.output.textLineLimit": 1000,
  "python.analysis.autoImportCompletions": false,
  "python.analysis.autoSearchPaths": false,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnusedVariable": "information"
  },
  "python.analysis.typeCheckingMode": "standard",
  "python.REPL.sendToNativeREPL": true,
  "python.terminal.activateEnvironment": false,
  "redhat.telemetry.enabled": false,
  "rust-analyzer.completion.autoimport.enable": false,
  "rust-analyzer.completion.callable.snippets": "add_parentheses",
  "rust-analyzer.completion.hideDeprecated": true,
  "rust-analyzer.completion.postfix.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.external.linuxExec": "xdg-terminal-exec",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.commandsToSkipShell": [
    "-workbench.action.quickOpen",
    "-workbench.action.terminal.killEditor"
  ],
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.fontFamily": "Input Mono Narrow",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.profiles.linux": {
    "fish": {
      "path": "/home/linuxbrew/.linuxbrew/bin/fish"
    }
  },
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "/opt/homebrew/bin/fish"
    }
  },
  "terminal.integrated.suggest.enabled": false,
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "vscode-neovim.ctrlKeysForInsertMode": [
    "a",
    "c",
    "d",
    "h",
    "j",
    "m",
    "o",
    "r",
    "t",
    "u",
    "w",
    "e"
  ],
  "vscode-neovim.neovimWidth": 200,
  "window.autoDetectColorScheme": true,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.enableExperiments": false,
  "workbench.startupEditor": "none",
  "workbench.tree.renderIndentGuides": "none",
  "zenMode.showTabs": "none"
}
