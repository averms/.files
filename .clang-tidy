# C99 checks

Checks: >-
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  clang-diagnostic-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-multi-level-implicit-pointer-conversion,
  -misc-unused-parameters,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-magic-numbers,

FormatStyle: file

CheckOptions:
  # False positive on macOS
  misc-include-cleaner.IgnoreHeaders: 'sys/errno\.h'
